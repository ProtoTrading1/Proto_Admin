PROCESSOR_API_KEY=replace-with-at-least-24-random-characters
PROCESSOR_CALLBACK_SECRET=replace-with-at-least-32-random-characters
PROCESSOR_CALLBACK_HOSTS=admin.example.invalid
PROCESSOR_DATA_DIR=./data
PROCESSOR_WORKERS=2
PROCESSOR_MAX_UPLOAD_BYTES=31457280

# Optional pull worker. Keep PROCESSOR_TRANSPORT=none for upload/poll API only.
PROCESSOR_TRANSPORT=none
PROCESSOR_ADMIN_API_URL=https://admin.example.invalid
PROCESSOR_ADMIN_API_TOKEN=replace-with-a-worker-only-token
PROCESSOR_TRANSPORT_ALLOWED_HOSTS=admin.example.invalid,staging.example.invalid
PROCESSOR_WORKER_ID=bladerunner-image-worker
PROCESSOR_POLL_SECONDS=10
